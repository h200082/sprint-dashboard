# 역할: Git에 저장하지 않을 생성물·의존성·로컬 설정을 지정합니다.
# 필요한 이유: 용량이 큰 파일과 개인 환경 파일이 저장소에 섞이는 것을 막아 재현 가능한 소스만 관리합니다.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# 이 저장소는 프론트엔드 대시보드만 공유합니다.
# 별도로 만든 Python/SQLAlchemy 연습 폴더가 `git add .`에 섞이지 않도록 제외합니다.
/practice/
